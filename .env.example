# Copy this file to .env.
# NEVER commit your real .env file or share your API keys / PINs.

# --- Broker Selection ---
# Set BROKER=groww if you trade on Groww app (default)
# Set BROKER=angel if you connect to Angel One SmartAPI
BROKER=groww

# Optional: Groww Trading API token (Only required if you subscribed to Groww's ₹499/mo Trading API)
GROWW_API_TOKEN=

# --- Angel One SmartAPI (Free market data feed for live index & options) ---
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# --- Optional Telegram Signal Alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Capital & Strict Risk Management (Optimized for High Win-Rate) ---
BOT_CAPITAL=5000
NIFTY_LOT_SIZE=65
MIN_LOTS=1
MAX_LOTS=1
MAX_TRADES_PER_DAY=1
MAX_DAILY_LOSS=800
STOP_LOSS_PCT=0.18
BREAKEVEN_TRIGGER_PCT=0.12
TRAIL_TRIGGER_PCT=0.20
TRAIL_OFFSET_PCT=0.10
TARGET_PCT=0.50

# --- Strategy Timing (Morning Momentum Window 09:30 - 11:15 IST) ---
ORB_START=09:15
ORB_END=09:30
LAST_ENTRY_TIME=11:15
SQUARE_OFF_TIME=15:15
POLL_INTERVAL_SECONDS=15
MAX_BREAKOUT_EXTENSION_PCT=0.0035

# Toggle individual confluence filters (true/false)
ENABLE_ADX_FILTER=true
MIN_ADX=20.0
ENABLE_HTF_FILTER=true
HTF_MINUTES=15
ENABLE_VOLUME_FILTER=true
MIN_VOLUME_RATIO=1.25
ENABLE_ORB_RANGE_FILTER=true
MAX_ORB_RANGE_PCT=0.0075
